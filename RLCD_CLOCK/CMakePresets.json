{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "esp-idf",
            "hidden": true,
            "generator": "Ninja",
            "toolchainFile": "$env{IDF_PATH}/tools/cmake/toolchain-esp32s3.cmake"
        },
        {
            "name": "zh-TW",
            "inherits": "esp-idf",
            "displayName": "繁體中文",
            "description": "ESP32-S3 RLCD 4.2 繁體中文映像",
            "binaryDir": "${sourceDir}/build_zh-TW",
            "cacheVariables": {
                "IDF_TARGET": "esp32s3",
                "APP_UI_LOCALE": "zh-TW"
            }
        },
        {
            "name": "zh-CN",
            "inherits": "esp-idf",
            "displayName": "简体中文",
            "description": "ESP32-S3 RLCD 4.2 简体中文映像",
            "binaryDir": "${sourceDir}/build_zh-CN",
            "cacheVariables": {
                "IDF_TARGET": "esp32s3",
                "APP_UI_LOCALE": "zh-CN"
            }
        },
        {
            "name": "en",
            "inherits": "esp-idf",
            "displayName": "English",
            "description": "ESP32-S3 RLCD 4.2 English image",
            "binaryDir": "${sourceDir}/build_en",
            "cacheVariables": {
                "IDF_TARGET": "esp32s3",
                "APP_UI_LOCALE": "en"
            }
        },
        {
            "name": "ja",
            "inherits": "esp-idf",
            "displayName": "日本語",
            "description": "ESP32-S3 RLCD 4.2 日本語映像",
            "binaryDir": "${sourceDir}/build_ja",
            "cacheVariables": {
                "IDF_TARGET": "esp32s3",
                "APP_UI_LOCALE": "ja"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "zh-TW",
            "configurePreset": "zh-TW"
        },
        {
            "name": "zh-CN",
            "configurePreset": "zh-CN"
        },
        {
            "name": "en",
            "configurePreset": "en"
        },
        {
            "name": "ja",
            "configurePreset": "ja"
        }
    ]
}
